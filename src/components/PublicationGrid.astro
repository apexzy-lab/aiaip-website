---
import { themes } from '@/data/site';
---
<div class="publication-grid">
  {themes.map((item) => (
    <article class="publication reveal">
      <a class:list={['cover', `cover-${item.cover}`]} href={`/research/${item.slug}`} aria-label={`Explore ${item.pageTitle}`}>
        <span>Research area · {item.number}</span><h3>{item.title}</h3><i></i>
      </a>
      <p class="meta">AIAIP research agenda</p><h3>{item.summary}</h3><a href={`/research/${item.slug}`}>Explore this area →</a>
    </article>
  ))}
</div>
