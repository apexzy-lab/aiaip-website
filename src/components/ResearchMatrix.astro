---
import { themes } from '@/data/site';

interface Props {
  overviewLink?: boolean;
}

const { overviewLink = false } = Astro.props;
---
<section class="research-matrix" id="research-areas" aria-labelledby="research-matrix-title">
  <div class="shell research-matrix-layout">
    <div class="research-matrix-intro">
      <p class="eyebrow matrix-eyebrow">Research agenda</p>
      <h2 id="research-matrix-title">Africa’s AI policy questions, connected.</h2>
      <p>Four domains. One agenda for institutions navigating technological change.</p>
      {overviewLink && <a href="/research">Explore all research <span aria-hidden="true">→</span></a>}
    </div>

    <div class="research-matrix-list">
      {themes.map((theme) => (
        <a class="research-matrix-row" href={`/research/${theme.slug}`} aria-label={`Explore ${theme.pageTitle}`}>
          <span class="research-matrix-number">{theme.number}</span>
          <div class="research-matrix-copy">
            <h3>{theme.title}</h3>
            <p>{theme.summary}</p>
            <ul aria-label={`${theme.title} topics`}>
              {theme.questions.map((question) => <li>{question}</li>)}
            </ul>
          </div>
          <span class="research-matrix-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
